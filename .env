# ---------------------------------------------------------------------------
# Finsetter CRM - environment configuration
# Copy this file to `.env` (already named .env) and adjust before deploying
# to production. Never commit real production secrets.
# ---------------------------------------------------------------------------

# PostgreSQL
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=finsetter_secure_pw_change_me
PGDATA=/var/lib/postgresql/data/pgdata

# Odoo
ODOO_DB_NAME=finsetter_crm
ODOO_ADMIN_PASSWD=finsetter_admin_change_me
ODOO_VERSION=17.0
HTTP_PORT=8069
LONGPOLLING_PORT=8072

# Company / branding (used by demo data + first-run wizard)
COMPANY_NAME=Finsetter Financial Services Pvt. Ltd.
COMPANY_EMAIL=info@thefinsetter.com
COMPANY_PHONE=+91 91822 49287
COMPANY_WHATSAPP=+91 94903 74717
COMPANY_WEBSITE=https://www.thefinsetter.com
