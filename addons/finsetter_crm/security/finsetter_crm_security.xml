<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Module category -->
        <record id="module_category_finsetter" model="ir.module.category">
            <field name="name">Finsetter CRM</field>
            <field name="description">Access rights for Finsetter Financial Services CRM</field>
            <field name="sequence">15</field>
        </record>

        <!-- Groups -->
        <record id="group_finsetter_advisor" model="res.groups">
            <field name="name">Advisor</field>
            <field name="category_id" ref="module_category_finsetter"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="comment">Can manage own leads, policies, calls and consent records.</field>
        </record>

        <record id="group_finsetter_sales_executive" model="res.groups">
            <field name="name">Sales Executive</field>
            <field name="category_id" ref="module_category_finsetter"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="comment">Front-line role: captures and qualifies leads, books appointments and runs
                campaigns, with read-only visibility on policies and claims.</field>
        </record>

        <record id="group_finsetter_team_lead" model="res.groups">
            <field name="name">Team Lead</field>
            <field name="category_id" ref="module_category_finsetter"/>
            <field name="implied_ids" eval="[(4, ref('group_finsetter_advisor'))]"/>
            <field name="comment">Can view/reassign all leads and policies within their team.</field>
        </record>

        <record id="group_finsetter_compliance" model="res.groups">
            <field name="name">Compliance Officer</field>
            <field name="category_id" ref="module_category_finsetter"/>
            <field name="comment">Read/audit access to consent register across the company (SEBI/IRDAI audit trail).</field>
        </record>

        <record id="group_finsetter_business_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_finsetter"/>
            <field name="implied_ids" eval="[(4, ref('group_finsetter_team_lead'))]"/>
            <field name="comment">Business oversight role: company-wide reporting, dashboards, campaigns and
                claims across every team, without system configuration access.</field>
        </record>

        <record id="group_finsetter_manager" model="res.groups">
            <field name="name">CRM Administrator</field>
            <field name="category_id" ref="module_category_finsetter"/>
            <field name="implied_ids" eval="[(4, ref('group_finsetter_business_manager')), (4, ref('sales_team.group_sale_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
            <field name="comment">Full access: configuration, all leads/policies/consent, dashboard, automation rules.
                Maps to the "Admin" role.</field>
        </record>

        <!-- Record rules -->
        <record id="finsetter_policy_rule_advisor" model="ir.rule">
            <field name="name">Policy: advisor sees own customers' policies</field>
            <field name="model_id" ref="model_finsetter_policy"/>
            <field name="domain_force">['|', ('advisor_id', '=', user.id), ('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_finsetter_advisor'))]"/>
        </record>

        <record id="finsetter_policy_rule_team_lead" model="ir.rule">
            <field name="name">Policy: team lead sees team policies</field>
            <field name="model_id" ref="model_finsetter_policy"/>
            <field name="domain_force">[('advisor_id.sale_team_id', 'in', user.crm_team_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_finsetter_team_lead'))]"/>
        </record>

        <record id="finsetter_policy_rule_manager" model="ir.rule">
            <field name="name">Policy: manager/compliance sees all</field>
            <field name="model_id" ref="model_finsetter_policy"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_finsetter_manager')), (4, ref('group_finsetter_compliance'))]"/>
        </record>

        <record id="finsetter_consent_rule_compliance" model="ir.rule">
            <field name="name">Consent: compliance/manager full read</field>
            <field name="model_id" ref="model_finsetter_consent"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_finsetter_manager')), (4, ref('group_finsetter_compliance'))]"/>
        </record>

        <record id="finsetter_consent_rule_advisor" model="ir.rule">
            <field name="name">Consent: advisor sees own records</field>
            <field name="model_id" ref="model_finsetter_consent"/>
            <field name="domain_force">['|', ('advisor_id', '=', user.id), ('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_finsetter_advisor'))]"/>
        </record>

        <!-- Claims: same ownership model as policies -->
        <record id="finsetter_claim_rule_advisor" model="ir.rule">
            <field name="name">Claim: advisor sees own customers' claims</field>
            <field name="model_id" ref="model_finsetter_claim"/>
            <field name="domain_force">['|', ('advisor_id', '=', user.id), ('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_finsetter_advisor')), (4, ref('group_finsetter_sales_executive'))]"/>
        </record>
        <record id="finsetter_claim_rule_manager" model="ir.rule">
            <field name="name">Claim: manager/team lead sees all</field>
            <field name="model_id" ref="model_finsetter_claim"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_finsetter_business_manager'))]"/>
        </record>

        <!-- Appointments: advisor sees their own diary -->
        <record id="finsetter_appointment_rule_advisor" model="ir.rule">
            <field name="name">Appointment: advisor sees own appointments</field>
            <field name="model_id" ref="model_finsetter_appointment"/>
            <field name="domain_force">['|', ('advisor_id', '=', user.id), ('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_finsetter_advisor')), (4, ref('group_finsetter_sales_executive'))]"/>
        </record>
        <record id="finsetter_appointment_rule_manager" model="ir.rule">
            <field name="name">Appointment: manager sees all</field>
            <field name="model_id" ref="model_finsetter_appointment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_finsetter_business_manager'))]"/>
        </record>

        <!-- Documents: same ownership model as consent (compliance-sensitive) -->
        <record id="finsetter_document_rule_advisor" model="ir.rule">
            <field name="name">Document: advisor sees own customers' documents</field>
            <field name="model_id" ref="model_finsetter_document"/>
            <field name="domain_force">['|', ('lead_id.user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_finsetter_advisor')), (4, ref('group_finsetter_sales_executive'))]"/>
        </record>
        <record id="finsetter_document_rule_manager" model="ir.rule">
            <field name="name">Document: manager/compliance sees all</field>
            <field name="model_id" ref="model_finsetter_document"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_finsetter_business_manager')), (4, ref('group_finsetter_compliance'))]"/>
        </record>

        <!-- Portal customers: strictly their own records only, on the
             models the customer portal exposes (spec: "Add customer
             portal"). -->
        <record id="finsetter_policy_rule_portal" model="ir.rule">
            <field name="name">Policy: portal customer sees own policies</field>
            <field name="model_id" ref="model_finsetter_policy"/>
            <field name="domain_force">[('partner_id', 'child_of', [user.partner_id.commercial_partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
        <record id="finsetter_appointment_rule_portal" model="ir.rule">
            <field name="name">Appointment: portal customer sees own appointments</field>
            <field name="model_id" ref="model_finsetter_appointment"/>
            <field name="domain_force">[('partner_id', 'child_of', [user.partner_id.commercial_partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
        <record id="finsetter_document_rule_portal" model="ir.rule">
            <field name="name">Document: portal customer sees own documents</field>
            <field name="model_id" ref="model_finsetter_document"/>
            <field name="domain_force">[('partner_id', 'child_of', [user.partner_id.commercial_partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
        <record id="finsetter_claim_rule_portal" model="ir.rule">
            <field name="name">Claim: portal customer sees own claims</field>
            <field name="model_id" ref="model_finsetter_claim"/>
            <field name="domain_force">[('partner_id', 'child_of', [user.partner_id.commercial_partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

    </data>
</odoo>
