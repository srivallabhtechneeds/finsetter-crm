<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Form view: Finsetter fields + smart buttons -->
        <record id="crm_lead_view_form_finsetter" model="ir.ui.view">
            <field name="name">crm.lead.form.finsetter</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">

                <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                    <button name="action_view_calls" type="object" class="oe_stat_button" icon="fa-phone">
                        <field name="call_log_count" widget="statinfo" string="Calls"/>
                    </button>
                    <button name="action_view_consent" type="object" class="oe_stat_button" icon="fa-check-square-o">
                        <field name="consent_count" widget="statinfo" string="Consent"/>
                    </button>
                    <button name="action_view_policies" type="object" class="oe_stat_button" icon="fa-file-text-o">
                        <field name="policy_count" widget="statinfo" string="Policies"/>
                    </button>
                    <button name="action_view_product_matches" type="object" class="oe_stat_button" icon="fa-bullseye">
                        <field name="product_match_count" widget="statinfo" string="Matches"/>
                    </button>
                    <button name="action_view_appointments" type="object" class="oe_stat_button" icon="fa-calendar">
                        <field name="appointment_count" widget="statinfo" string="Appointments"/>
                    </button>
                    <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-folder-open">
                        <field name="document_count" widget="statinfo" string="Documents"/>
                    </button>
                </xpath>

                <xpath expr="//div[hasclass('oe_title')]" position="before">
                    <widget name="web_ribbon" title="SLA Breached" bg_color="text-bg-danger"
                            invisible="sla_status != 'breached'"/>
                </xpath>

                <!-- Odoo 19: the partner group renders without field labels, so the
                     Finsetter fields get their own labelled section below it. -->
                <xpath expr="//group[@name='lead_partner']/.." position="after">
                    <group name="finsetter_lead_info">
                        <group string="Finsetter Profile">
                            <field name="lead_relationship"/>
                            <field name="lead_status" widget="badge"
                                   decoration-success="lead_status == 'converted'"
                                   decoration-danger="lead_status == 'lost'"
                                   decoration-warning="lead_status in ('interested', 'quote_sent')"/>
                            <field name="product_line_id" options="{'no_create': True}"/>
                            <field name="product_line_talking_point" invisible="not product_line_talking_point"/>
                            <field name="product_line_website_url" widget="url" string="Service Page"
                                   invisible="not product_line_website_url"/>
                            <field name="campaign_source_id"/>
                            <field name="is_nri"/>
                            <field name="preferred_language"/>
                            <field name="consultation_type"/>
                        </group>
                        <group string="Consent &amp; Response">
                            <field name="call_consent_status" widget="badge"
                                   decoration-success="call_consent_status == 'granted'"
                                   decoration-danger="call_consent_status in ('declined', 'withdrawn')"
                                   decoration-warning="call_consent_status == 'unknown'"/>
                            <field name="sla_deadline"/>
                            <field name="sla_status" widget="badge"
                                   decoration-success="sla_status == 'met'"
                                   decoration-danger="sla_status == 'breached'"
                                   decoration-warning="sla_status == 'pending'"/>
                            <field name="channel_whatsapp"/>
                            <field name="channel_sms"/>
                            <field name="channel_email"/>
                            <field name="channel_ai_call"/>
                        </group>
                    </group>
                </xpath>

                <xpath expr="//button[@name='action_view_calls']" position="after">
                    <button name="action_log_call" type="object" string="Log Call"
                            class="btn-secondary" icon="fa-phone"/>
                    <button name="action_find_matching_products" type="object" string="Find Matching Products"
                            class="btn-secondary" icon="fa-bullseye"/>
                        <button name="action_create_product_campaign" type="object" string="Campaign Matched Products"
                            class="btn-secondary" icon="fa-paper-plane"/>
                    <button name="action_open_calculators" type="object" string="Calculators"
                            class="btn-secondary" icon="fa-calculator"/>
                </xpath>

                <xpath expr="//page[@name='internal_notes']" position="before">
                    <page string="Customer 360" name="finsetter_customer_360">
                        <group string="Existing Customer Follow-up"
                               invisible="lead_relationship != 'existing'">
                            <group>
                                <button name="action_view_policies" type="object" string="Renewal Options"
                                        class="btn-secondary" icon="fa-refresh"/>
                                <button name="action_find_matching_products" type="object"
                                        string="Find Upgrade Options" class="btn-secondary" icon="fa-level-up"/>
                            </group>
                            <group>
                                <field name="existing_followup_type"/>
                                <field name="existing_followup_date"/>
                                <button name="action_schedule_existing_followup" type="object"
                                        string="Schedule Follow-up" class="btn-primary" icon="fa-calendar"/>
                            </group>
                        </group>
                        <group>
                            <group string="Profile">
                                <field name="finsetter_age"/>
                                <field name="finsetter_occupation"/>
                                <field name="finsetter_annual_income"/>
                                <field name="company_currency" invisible="1"/>
                            </group>
                            <group string="Health Condition">
                                <field name="health_status"/>
                                <field name="health_problem" invisible="health_status != 'unhealthy'"
                                       required="health_status == 'unhealthy'"/>
                            </group>
                        </group>
                        <group string="Goals &amp; Requirements">
                            <field name="finsetter_financial_goals" placeholder="e.g. Child's education in 2035, retire at 55..."/>
                            <field name="finsetter_requirements" placeholder="Anything the advisor should know before recommending..."/>
                        </group>

                        <!-- Header row: section title on the left, action on the
                             right, then the matches table at full width. -->
                        <div class="fs_section_header">
                            <span class="fs_section_title">Product Matches</span>
                            <button name="action_find_matching_products" type="object" string="Match Products"
                                    class="btn btn-secondary btn-sm" icon="fa-search"/>
                        </div>
                        <field name="product_match_ids" nolabel="1" class="fs_match_list"
                               context="{'default_lead_id': id}">
                            <list editable="bottom" decoration-muted="status == 'rejected'">
                                <field name="product_id" string="Product"/>
                                <field name="product_line_id" optional="show"/>
                                <field name="score" string="Score" widget="progressbar" width="140px"/>
                                <field name="reason" string="Why"/>
                                <field name="status" string="Status" widget="badge"
                                       decoration-info="status == 'recommended'"
                                       decoration-primary="status == 'interested'"
                                       decoration-warning="status == 'pending'"
                                       decoration-danger="status == 'rejected'"
                                       decoration-success="status == 'converted'"/>
                                <button name="action_mark_interested" type="object" title="Interested"
                                        icon="fa-thumbs-o-up" class="text-primary"
                                        invisible="status != 'recommended'"/>
                                <button name="action_mark_converted" type="object" title="Converted"
                                        icon="fa-check" class="text-success"
                                        invisible="status in ('converted', 'rejected')"/>
                                <button name="action_mark_rejected" type="object" title="Reject"
                                        icon="fa-times" class="text-danger"
                                        invisible="status in ('rejected', 'converted')"/>
                            </list>
                        </field>
                    </page>
                </xpath>

            </field>
        </record>

        <!-- List views: add product line + consent columns to both the
             Leads list and the Opportunities (Pipeline) list. -->
        <record id="crm_lead_view_tree_finsetter" model="ir.ui.view">
            <field name="name">crm.lead.tree.finsetter.leads</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="phone" optional="show"/>
                    <field name="email_from" optional="show"/>
                    <field name="source_id" optional="show"/>
                    <field name="product_line_id" optional="show"/>
                    <field name="user_id" optional="show"/>
                    <field name="lead_status" optional="show" widget="badge"/>
                    <field name="channel_whatsapp" optional="hide"/>
                    <field name="channel_sms" optional="hide"/>
                    <field name="channel_email" optional="hide"/>
                    <field name="channel_ai_call" optional="hide"/>
                    <field name="call_consent_status" optional="show" widget="badge"
                           decoration-success="call_consent_status == 'granted'"
                           decoration-danger="call_consent_status in ('declined', 'withdrawn')"/>
                </xpath>
            </field>
        </record>
        <record id="crm_lead_view_tree_oppor_finsetter" model="ir.ui.view">
            <field name="name">crm.lead.tree.finsetter.oppor</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="product_line_id" optional="show"/>
                    <field name="channel_whatsapp" optional="hide"/>
                    <field name="channel_sms" optional="hide"/>
                    <field name="channel_email" optional="hide"/>
                    <field name="channel_ai_call" optional="hide"/>
                    <field name="call_consent_status" optional="show" widget="badge"
                           decoration-success="call_consent_status == 'granted'"
                           decoration-danger="call_consent_status in ('declined', 'withdrawn')"/>
                </xpath>
            </field>
        </record>

        <!-- Search view: filters & group-by for product line / consent -->
        <record id="crm_lead_view_search_finsetter" model="ir.ui.view">
            <field name="name">crm.lead.search.finsetter</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.view_crm_case_leads_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <filter string="Call Consent Missing" name="finsetter_consent_missing"
                            domain="[('call_consent_status', '=', 'unknown')]"/>
                        <filter string="New" name="finsetter_status_new" domain="[('lead_status', '=', 'new')]"/>
                        <filter string="Contacted" name="finsetter_status_contacted" domain="[('lead_status', '=', 'contacted')]"/>
                        <filter string="Interested" name="finsetter_status_interested" domain="[('lead_status', '=', 'interested')]"/>
                        <filter string="Quote Sent" name="finsetter_status_quote_sent" domain="[('lead_status', '=', 'quote_sent')]"/>
                        <filter string="Converted" name="finsetter_status_converted" domain="[('lead_status', '=', 'converted')]"/>
                        <filter string="Lost" name="finsetter_status_lost" domain="[('lead_status', '=', 'lost')]"/>
                    <filter string="NRI Leads" name="finsetter_nri" domain="[('is_nri', '=', True)]"/>
                        <filter string="Product Line" name="finsetter_groupby_product_line"
                            context="{'group_by': 'product_line_id'}"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
