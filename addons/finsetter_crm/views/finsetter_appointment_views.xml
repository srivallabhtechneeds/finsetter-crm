<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="finsetter_appointment_view_form" model="ir.ui.view">
            <field name="name">finsetter.appointment.form</field>
            <field name="model">finsetter.appointment</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_mark_confirmed" type="object" string="Confirm" invisible="status != 'scheduled'"/>
                        <button name="action_mark_completed" type="object" string="Mark Completed" class="btn-primary" invisible="status not in ('scheduled', 'confirmed')"/>
                        <button name="action_mark_no_show" type="object" string="No Show" invisible="status not in ('scheduled', 'confirmed')"/>
                        <button name="action_cancel" type="object" string="Cancel" invisible="status in ('completed', 'cancelled')"/>
                        <field name="status" widget="statusbar" statusbar_visible="scheduled,confirmed,completed"/>
                    </header>
                    <sheet>
                        <field name="calendar_event_id" invisible="1"/>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_calendar_event" type="object" class="oe_stat_button" icon="fa-calendar" invisible="not calendar_event_id">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Calendar Event</span>
                                </div>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id"/>
                                <field name="lead_id"/>
                                <field name="advisor_id"/>
                                <field name="product_line_id"/>
                            </group>
                            <group>
                                <field name="appointment_datetime"/>
                                <field name="duration" widget="float_time"/>
                                <field name="mode"/>
                            </group>
                        </group>
                        <group string="Notes">
                            <field name="notes" nolabel="1"/>
                        </group>
                        <div class="alert alert-info" role="alert" invisible="not calendar_event_id">
                            This appointment is synced to a calendar event. Connect Google Calendar under
                            Settings &gt; General Settings &gt; Integrations to see it sync to the advisor's
                            Google Calendar automatically.
                        </div>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="finsetter_appointment_view_tree" model="ir.ui.view">
            <field name="name">finsetter.appointment.tree</field>
            <field name="model">finsetter.appointment</field>
            <field name="arch" type="xml">
                <tree decoration-muted="status in ('cancelled', 'no_show')" decoration-success="status == 'completed'">
                    <field name="appointment_datetime"/>
                    <field name="partner_id"/>
                    <field name="advisor_id"/>
                    <field name="product_line_id"/>
                    <field name="mode"/>
                    <field name="status" widget="badge"/>
                </tree>
            </field>
        </record>

        <record id="finsetter_appointment_view_calendar" model="ir.ui.view">
            <field name="name">finsetter.appointment.calendar</field>
            <field name="model">finsetter.appointment</field>
            <field name="arch" type="xml">
                <calendar date_start="appointment_datetime" string="Appointments" color="advisor_id" mode="week" quick_create="0">
                    <field name="partner_id"/>
                    <field name="advisor_id"/>
                    <field name="mode"/>
                </calendar>
            </field>
        </record>

        <record id="finsetter_action_appointments" model="ir.actions.act_window">
            <field name="name">Appointments</field>
            <field name="res_model">finsetter.appointment</field>
            <field name="view_mode">calendar,list,form</field>
            <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Book the free 30-45 minute consultation Finsetter offers on the website.</p></field>
        </record>

    </data>
</odoo>
