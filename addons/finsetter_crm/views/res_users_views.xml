<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Settings > Users > (user) > Communication Channels:
             per-user email / SMS / WhatsApp / voice identities. -->
        <record id="view_users_form_finsetter_channels" model="ir.ui.view">
            <field name="name">res.users.form.finsetter.channels</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='access_rights']/.." position="inside">
                    <page string="Communication Channels" name="finsetter_channels"
                          groups="base.group_system,finsetter_crm.group_finsetter_manager">
                        <div class="alert alert-info mb-4" role="status">
                            These are the numbers and address this user's customers see and reply to.
                            Leave a channel blank to keep using the company's shared details for it.
                            Switching a channel off stops this user sending on it altogether — it does
                            not fall back to the company account. Agents cannot see or edit any of this.
                        </div>
                        <group>
                            <group string="Email" name="fs_channel_email">
                                <field name="fs_email_enabled" string="Enabled" widget="boolean_toggle"/>
                                <field name="fs_email_from" placeholder="e.g. leads@thefinsetter.com"
                                       readonly="not fs_email_enabled"/>
                                <field name="fs_mail_server_id" string="Outgoing Mail Server" options="{'no_create': True}"
                                       placeholder="Company default" readonly="not fs_email_enabled"/>
                            </group>
                            <group string="SMS" name="fs_channel_sms">
                                <field name="fs_sms_enabled" string="Enabled" widget="boolean_toggle"/>
                                <field name="fs_sms_sender" placeholder="e.g. FINSET or +14155551234"
                                       readonly="not fs_sms_enabled"/>
                            </group>
                        </group>
                        <group>
                            <group string="WhatsApp" name="fs_channel_whatsapp">
                                <field name="fs_whatsapp_enabled" string="Enabled" widget="boolean_toggle"/>
                                <field name="fs_whatsapp_number" placeholder="e.g. +919490374717"
                                       readonly="not fs_whatsapp_enabled"/>
                                <field name="fs_whatsapp_meta_phone_id" placeholder="e.g. 104786699175041"
                                       readonly="not fs_whatsapp_enabled"/>
                            </group>
                            <group string="Voice" name="fs_channel_voice">
                                <field name="fs_voice_enabled" string="Enabled" widget="boolean_toggle"/>
                                <field name="fs_voice_phone_number_id" readonly="not fs_voice_enabled"/>
                                <field name="fs_voice_assistant_id" readonly="not fs_voice_enabled"/>
                                <field name="fs_voice_api_key" string="API Key" password="True"
                                       readonly="not fs_voice_enabled"/>
                            </group>
                        </group>
                        <group string="Administrator" name="fs_channel_admin">
                            <field name="fs_channels_active"/>
                            <field name="fs_house_identity"/>
                            <field name="fs_personalised_channels"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
