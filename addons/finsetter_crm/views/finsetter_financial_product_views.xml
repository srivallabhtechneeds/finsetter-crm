<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="finsetter_financial_product_view_form" model="ir.ui.view">
            <field name="name">finsetter.financial.product.form</field>
            <field name="model">finsetter.financial.product</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="status" widget="statusbar" statusbar_visible="draft,active"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_matches" type="object" class="oe_stat_button" icon="fa-bullseye">
                                <field name="match_count" widget="statinfo" string="Lead Matches"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="e.g. SecureLife Term Plan"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="product_line_id"/>
                                <field name="provider"/>
                                <field name="website_url" widget="url"/>
                                <field name="active" invisible="1"/>
                            </group>
                            <group>
                                <field name="amount_type"/>
                                <field name="min_amount"/>
                                <field name="max_amount"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="min_age"/>
                                <field name="max_age"/>
                            </group>
                            <group>
                                <field name="tenure_months_min"/>
                                <field name="tenure_months_max"/>
                            </group>
                        </group>
                        <group>
                            <field name="commission_rate"/>
                            <field name="commission_flat"/>
                        </group>
                        <notebook>
                            <page string="Eligibility">
                                <field name="eligibility_criteria"/>
                            </page>
                            <page string="Benefits">
                                <field name="benefits"/>
                            </page>
                            <page string="Documents Required">
                                <field name="documents_required"/>
                            </page>
                            <page string="Passport Details">
                                <group>
                                    <group>
                                        <field name="passport_number"/>
                                        <field name="passport_nationality"/>
                                    </group>
                                    <group>
                                        <field name="passport_issue_date"/>
                                        <field name="passport_expiry_date"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="finsetter_financial_product_view_tree" model="ir.ui.view">
            <field name="name">finsetter.financial.product.tree</field>
            <field name="model">finsetter.financial.product</field>
            <field name="arch" type="xml">
                <tree decoration-muted="status in ('inactive', 'discontinued')">
                    <field name="name"/>
                    <field name="product_line_id"/>
                    <field name="provider"/>
                    <field name="amount_type"/>
                    <field name="min_amount"/>
                    <field name="max_amount"/>
                    <field name="commission_rate"/>
                    <field name="status" widget="badge" decoration-success="status == 'active'" decoration-info="status == 'draft'"/>
                </tree>
            </field>
        </record>

        <record id="finsetter_financial_product_view_search" model="ir.ui.view">
            <field name="name">finsetter.financial.product.search</field>
            <field name="model">finsetter.financial.product</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="product_line_id"/>
                    <field name="provider"/>
                    <filter string="Active" name="active_status" domain="[('status', '=', 'active')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Category" name="group_line" context="{'group_by': 'product_line_id'}"/>
                        <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="finsetter_action_financial_products" model="ir.actions.act_window">
            <field name="name">Financial Products</field>
            <field name="res_model">finsetter.financial.product</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Add Finsetter's real product catalog here — term plans, health covers, mutual funds, tax-saving instruments, pension plans and estate-planning services.</p></field>
        </record>

    </data>
</odoo>
